  function opd(){
    const el = document.getElementById('nD');
    if(!el) return;
    let ms = FAKTA.maalTid - new Date();
    if(ms < 0) ms = 0;
    const s = Math.floor(ms/1000);
    el.textContent = Math.floor(s/86400);
    document.getElementById('nT').textContent = Math.floor(s%86400/3600);
    document.getElementById('nM').textContent = Math.floor(s%3600/60);
    document.getElementById('nS').textContent = s%60;
    setTimeout(opd, 1000);
  }
  opd();
}

