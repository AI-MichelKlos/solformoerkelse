<!DOCTYPE html>
<html lang="da">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>Solformørkelses-Missionen — spil om solformørkelsen 12. august 2026</title>
<meta name="description" content="Et lille spil til børn om den delvise solformørkelse over Danmark den 12. august 2026. Lav formørkelsen selv, og lær hvordan man ser på den uden at komme til skade.">
<meta name="author" content="Michel Klos">
<meta name="theme-color" content="#0a0e1f">
<meta property="og:title" content="Solformørkelses-Missionen">
<meta property="og:description" content="Et spil om solformørkelsen den 12. august 2026. Lavet af Michel Klos.">
<meta property="og:type" content="website">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>&#127768;</text></svg>">
<style>
/* ==================================================================
   SOLFORMØRKELSES-MISSIONEN
   Et spil om den delvise solformørkelse over Danmark 12. august 2026
   Lavet af Michel Klos
   ================================================================== */

*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;margin:0;padding:0}
html,body{height:100%}
body{
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
  background:#0a0e1f;color:#f0f2f8;overflow-x:hidden;
  overscroll-behavior:none;-webkit-user-select:none;user-select:none;
}
input{-webkit-user-select:text;user-select:text}
#stjerner{position:fixed;inset:0;z-index:0;pointer-events:none}
.wrap{position:relative;z-index:1;max-width:520px;margin:0 auto;padding:16px 16px 40px;min-height:100%}

h1{font-size:30px;line-height:1.15;letter-spacing:-.5px;margin-bottom:10px}
h2{font-size:23px;line-height:1.2;margin-bottom:8px}
p{font-size:17px;line-height:1.5;color:#c3cadf}
.lille{font-size:14px;color:#8e97b5}

.kort{background:rgba(255,255,255,.055);border:1px solid rgba(255,255,255,.11);
  border-radius:20px;padding:18px;margin-bottom:14px;backdrop-filter:blur(6px)}
.badge{display:inline-block;font-size:12px;font-weight:700;letter-spacing:1.4px;
  text-transform:uppercase;color:#ffd166;background:rgba(255,209,102,.13);
  border:1px solid rgba(255,209,102,.3);border-radius:99px;padding:5px 13px;margin-bottom:12px}
.knap{display:block;width:100%;border:0;border-radius:16px;padding:17px 20px;
  font-size:18px;font-weight:700;font-family:inherit;color:#0a0e1f;
  background:linear-gradient(135deg,#ffd166,#ff9f45);cursor:pointer;margin-top:10px;
  transition:transform .12s;box-shadow:0 6px 20px rgba(255,159,69,.28)}
.knap:active{transform:scale(.97)}
.knap.sekundaer{background:transparent;color:#c3cadf;
  border:1.5px solid rgba(255,255,255,.2);box-shadow:none;font-size:16px}
.skjul{display:none !important}

.top{display:flex;align-items:center;gap:10px;margin-bottom:16px;padding-top:6px}
.bar{flex:1;height:8px;background:rgba(255,255,255,.1);border-radius:99px;overflow:hidden}
.bar>i{display:block;height:100%;width:0;border-radius:99px;
  background:linear-gradient(90deg,#ffd166,#ff9f45);transition:width .5s}
.stjernetal{font-size:16px;font-weight:800;color:#ffd166;white-space:nowrap}

.tur{display:flex;align-items:center;gap:9px;justify-content:center;font-size:15px;
  font-weight:700;margin-bottom:14px;padding:9px;border-radius:14px;background:rgba(255,255,255,.05)}
.prik{width:11px;height:11px;border-radius:50%;flex:none}
.p1{background:#7ad7f0}.p2{background:#f78fb3}.pb{background:#ffd166}

/* Opsætning: antal spillere + navne */
.spillervalg{display:grid;gap:11px}
.spillervalg button{display:flex;align-items:center;gap:12px;width:100%;font-family:inherit;
  font-size:19px;font-weight:700;color:#f0f2f8;text-align:left;background:rgba(255,255,255,.07);
  border:1.5px solid rgba(255,255,255,.16);border-radius:16px;padding:16px 18px;
  cursor:pointer;transition:transform .12s}
.spillervalg button:active{transform:scale(.97)}
.spillervalg small{font-size:13px;font-weight:500;color:#8e97b5;margin-left:auto;text-align:right}
.navnefelt{display:flex;align-items:center;gap:11px;margin-bottom:11px}
.navnefelt input{flex:1;font-family:inherit;font-size:18px;font-weight:600;color:#f0f2f8;
  background:rgba(255,255,255,.07);border:1.5px solid rgba(255,255,255,.16);
  border-radius:14px;padding:14px 16px;outline:none;min-width:0}
.navnefelt input:focus{border-color:#ffd166}

/* Videoplads */
.videoslot{position:relative;width:100%;aspect-ratio:16/9;border-radius:16px;overflow:hidden;
  background:rgba(255,255,255,.04);border:1.5px dashed rgba(255,255,255,.22);
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  text-align:center;padding:16px;margin-bottom:14px}
.videoslot video,.videoslot iframe{position:absolute;inset:0;width:100%;height:100%;
  border:0;object-fit:cover;background:#000}
.videoslot .ikon{font-size:30px;margin-bottom:8px;opacity:.5}
.videoslot .txt{font-size:13px;color:#8e97b5;line-height:1.45}

.valg{display:grid;gap:11px;margin-top:14px}
.valg button{width:100%;text-align:left;font-family:inherit;font-size:17px;font-weight:600;
  color:#f0f2f8;background:rgba(255,255,255,.07);border:1.5px solid rgba(255,255,255,.15);
  border-radius:16px;padding:16px 18px;cursor:pointer;transition:all .15s;line-height:1.35}
.valg button:active{transform:scale(.98)}
.valg button.rigtigt{background:rgba(107,222,138,.2);border-color:#6bde8a;color:#c8f7d4}
.valg button.forkert{background:rgba(255,107,107,.16);border-color:#ff6b6b;color:#ffc9c9}
.valg button:disabled{cursor:default;opacity:.85}

.feedback{margin-top:14px;padding:15px 17px;border-radius:16px;font-size:16px;line-height:1.5;
  border-left:4px solid #ffd166;background:rgba(255,209,102,.1);color:#f4e7c8}
.feedback b{color:#ffd166}

#scene{position:relative;width:100%;aspect-ratio:1/1;max-height:min(58vh,420px);
  border-radius:22px;overflow:hidden;margin-bottom:12px;touch-action:none;
  background:linear-gradient(#1d3b7a,#4a7fc4 55%,#f0a868)}
#scene svg{position:absolute;inset:0;width:100%;height:100%}
#maanehaand{cursor:grab}
#hjaelp{position:absolute;left:50%;bottom:12px;transform:translateX(-50%);font-size:13px;
  font-weight:600;color:#fff;background:rgba(0,0,0,.45);padding:8px 15px;border-radius:99px;
  white-space:nowrap;pointer-events:none;transition:opacity .3s}
.maalere{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-bottom:12px}
.maaler{background:rgba(255,255,255,.06);border-radius:14px;padding:11px 8px;text-align:center}
.maaler .v{font-size:21px;font-weight:800;color:#ffd166;line-height:1.1}
.maaler .n{font-size:11px;color:#8e97b5;margin-top:3px;letter-spacing:.4px}

.ting{display:grid;grid-template-columns:1fr 1fr;gap:11px;margin-top:14px}
.ting button{font-family:inherit;background:rgba(255,255,255,.07);
  border:1.5px solid rgba(255,255,255,.15);border-radius:18px;padding:16px 10px;
  cursor:pointer;color:#f0f2f8;transition:all .15s}
.ting button:active{transform:scale(.96)}
.ting .em{font-size:32px;display:block;margin-bottom:7px}
.ting .na{font-size:14px;font-weight:600;line-height:1.25}
.ting button.ja{background:rgba(107,222,138,.2);border-color:#6bde8a}
.ting button.nej{background:rgba(255,107,107,.16);border-color:#ff6b6b}
.ting button.faerdig{opacity:.5}

input[type=range]{-webkit-appearance:none;width:100%;height:34px;background:transparent;margin-top:6px}
input[type=range]::-webkit-slider-runnable-track{height:8px;border-radius:99px;background:rgba(255,255,255,.16)}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:30px;height:30px;
  border-radius:50%;margin-top:-11px;background:linear-gradient(135deg,#ffd166,#ff9f45);
  border:3px solid #0a0e1f;box-shadow:0 3px 10px rgba(0,0,0,.4)}
input[type=range]::-moz-range-track{height:8px;border-radius:99px;background:rgba(255,255,255,.16)}
input[type=range]::-moz-range-thumb{width:26px;height:26px;border-radius:50%;
  border:3px solid #0a0e1f;background:#ffd166}
#banesvg{width:100%;height:150px;display:block;margin-top:4px}

#diplom{background:linear-gradient(150deg,#131a35,#1e2954);
  border:2px solid rgba(255,209,102,.42);border-radius:24px;padding:28px 22px;text-align:center}
#diplom .segl{font-size:52px;margin-bottom:6px}
#diplom .navne{font-size:27px;font-weight:800;color:#ffd166;margin:12px 0;line-height:1.25;
  word-break:break-word}
#diplom hr{border:0;border-top:1px solid rgba(255,255,255,.15);margin:18px 0}

.nedtael{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:8px 0 4px}
.nedtael div{background:rgba(255,255,255,.06);border-radius:13px;padding:11px 3px}
.nedtael .t{font-size:23px;font-weight:800;color:#ffd166;line-height:1}
.nedtael .l{font-size:10px;color:#8e97b5;margin-top:4px;letter-spacing:.5px}

ul.huske{list-style:none;text-align:left;margin-top:10px}
ul.huske li{font-size:16px;line-height:1.45;color:#c3cadf;padding:9px 0 9px 30px;
  position:relative;border-bottom:1px solid rgba(255,255,255,.07)}
ul.huske li:last-child{border-bottom:0}
ul.huske li::before{content:"\2611";position:absolute;left:0;top:8px;color:#ffd166;font-size:17px}

.advarsel{background:rgba(255,107,107,.13);border:1.5px solid rgba(255,107,107,.42);
  border-radius:18px;padding:16px 18px;margin-bottom:14px}
.advarsel b{color:#ff9b9b;display:block;margin-bottom:5px;font-size:16px}
.advarsel p{font-size:15px;color:#ffd4d4}

.kredit{text-align:center;font-size:13px;color:#6f7899;line-height:1.7;margin-top:26px;
  padding-top:18px;border-top:1px solid rgba(255,255,255,.08)}
.kredit b{color:#8e97b5;font-weight:700}

@keyframes ind{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
.skaerm{animation:ind .35s ease-out}
@keyframes puls{0%,100%{transform:scale(1)}50%{transform:scale(1.06)}}
.pulser{animation:puls 1.6s ease-in-out infinite}
</style>
</head>
<body>

<canvas id="stjerner"></canvas>
<div class="wrap">
  <div class="top skjul" id="top">
    <div class="bar"><i id="barfyld"></i></div>
    <div class="stjernetal" id="stjernetal">⭐ 0</div>
  </div>
  <div id="app"></div>
</div>

<script>
/* ==================================================================
   1) VIDEOER
   ------------------------------------------------------------------
   Læg dine fem videoer i mappen "videos/" med præcis disse filnavne,
   så finder spillet dem selv. Mangler en fil, viser spillet i stedet
   en kort beskrivelse — spillet virker fint uden videoerne.

   Vil du hellere bruge YouTube, så skriv et embed-link i stedet, fx:
   intro: "https://www.youtube.com/embed/XXXXXXXXXXX"
   ================================================================== */
const VIDEOER = {
  intro:    "videos/1-intro.mp4",
  historie: "videos/2-vikingemyten.mp4",
  maane:    "videos/3-maanen-glider-ind.mp4",
  moerke:   "videos/4-dyrene-i-moerket.mp4",
  sikker:   "videos/5-solbriller.mp4"
};

/* Tekst der vises, hvis videofilen ikke findes */
const VIDEOTEKST = {
  intro:    "Solen på en blå himmel — månen glider langsomt ind foran og gør himlen mørkere.",
  historie: "Vikingemyten: en stor ulv bider i solen, mens folk nedenfor slår på skjolde.",
  maane:    "Set fra rummet: månen lægger sig mellem solen og Jorden og kaster en rund skygge.",
  moerke:   "Sen sommeraften: lyset bliver gråt og underligt, og fuglene holder op med at synge.",
  sikker:   "Et barn tager solformørkelsesbriller på og kigger trygt op mod himlen."
};

/* ==================================================================
   2) FAKTA — tallene gælder for København.
      I Vestjylland dækkes op til 88 % af solen.
   ================================================================== */
const FAKTA = {
  dato:     "12. august 2026",
  start:    "19:10",
  maksimum: "20:04",
  slut:     "20:54",
  daekning: 83,
  maalTid:  new Date(2026, 7, 12, 20, 4, 0)
};

/* ====================== Stjernehimmel ====================== */
(function(){
  const c = document.getElementById('stjerner'), x = c.getContext('2d');
  let s = [];
  function nyt(){
    c.width = innerWidth; c.height = innerHeight;
    s = Array.from({length:90}, () => ({
      x:Math.random()*c.width, y:Math.random()*c.height,
      r:Math.random()*1.4+.3, f:Math.random()*Math.PI*2, h:Math.random()*.02+.005
    }));
  }
  function tegn(){
    x.clearRect(0,0,c.width,c.height);
    for(const p of s){
      p.f += p.h;
      x.globalAlpha = .25 + Math.abs(Math.sin(p.f))*.6;
      x.fillStyle = '#fff';
      x.beginPath(); x.arc(p.x,p.y,p.r,0,7); x.fill();
    }
    requestAnimationFrame(tegn);
  }
  nyt(); tegn(); addEventListener('resize', nyt);
})();

/* ====================== Lyd ====================== */
let lyd = null;
function bip(hz, laengde, type){
  try{
    lyd = lyd || new (window.AudioContext||window.webkitAudioContext)();
    const o = lyd.createOscillator(), g = lyd.createGain();
    o.type = type || 'sine'; o.frequency.value = hz;
    o.connect(g); g.connect(lyd.destination);
    g.gain.setValueAtTime(.09, lyd.currentTime);
    g.gain.exponentialRampToValueAtTime(.001, lyd.currentTime + laengde);
    o.start(); o.stop(lyd.currentTime + laengde);
  }catch(e){}
}
const lydJa  = () => { bip(660,.12); setTimeout(()=>bip(990,.22),110); };
const lydNej = () => bip(180,.28,'square');
const lydWow = () => { [523,659,784,1047].forEach((h,i)=>setTimeout(()=>bip(h,.3),i*95)); };

/* ====================== Tilstand ====================== */
const app = document.getElementById('app');
let stjerner = 0, trin = 0;
let navne = ["Spiller 1"];            // 1 eller 2 navne
const ANTAL_TRIN = 9;

const O = {
  get solo(){ return navne.length === 1; },
  du(){     return this.solo ? 'du'  : 'I'; },
  duStor(){ return this.solo ? 'Du'  : 'I'; },
  dig(){    return this.solo ? 'dig' : 'jer'; },
  dinStor(){return this.solo ? 'Din' : 'Jeres'; },
  erVoksne(){ return this.solo ? 'du er voksen' : 'I er voksne'; },
  alle(){   return this.solo ? sikkerTekst(navne[0])
                             : sikkerTekst(navne[0]) + ' &amp; ' + sikkerTekst(navne[1]); },
  titel(){  return this.solo ? 'Certificeret Solformørkelses-ekspert'
                             : 'Certificerede Solformørkelses-eksperter'; }
};

function opdaterTop(){
  document.getElementById('top').classList.remove('skjul');
  document.getElementById('barfyld').style.width = (trin/ANTAL_TRIN*100) + '%';
  document.getElementById('stjernetal').textContent = '⭐ ' + stjerner;
}
function giv(n){ stjerner += n; opdaterTop(); }
function tk(s){ return s.replace(/\{I\}/g,O.du()).replace(/\{Is\}/g,O.duStor()).replace(/\{jer\}/g,O.dig()); }
function sikkerTekst(s){
  return String(s).replace(/[<>&"]/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;'}[c]));
}

function videoHTML(noegle){
  const kilde = VIDEOER[noegle];
  const pladsholder = `<div class="ikon">🎬</div><div class="txt">${VIDEOTEKST[noegle]||''}</div>`;
  if(!kilde) return `<div class="videoslot">${pladsholder}</div>`;
  const erFil = /\.(mp4|webm|mov|m4v)(\?|$)/i.test(kilde);
  const medie = erFil
    ? `<video src="${kilde}" controls playsinline preload="metadata" onerror="this.remove()"></video>`
    : `<iframe src="${kilde}" allow="accelerometer;autoplay;encrypted-media;gyroscope;picture-in-picture" allowfullscreen></iframe>`;
  return `<div class="videoslot">${pladsholder}${medie}</div>`;
}

/* nr: 0 = første spiller, 1 = anden spiller, 'begge' = sammen */
function tur(nr){
  if(O.solo) return `<div class="tur"><span class="prik p1"></span>${sikkerTekst(navne[0])}</div>`;
  if(nr === 'begge')
    return `<div class="tur"><span class="prik pb"></span>${sikkerTekst(navne[0])} og ${sikkerTekst(navne[1])} — sammen!</div>`;
  return `<div class="tur"><span class="prik p${nr+1}"></span>${sikkerTekst(navne[nr])}s tur</div>`;
}
function navnPaa(nr){
  return sikkerTekst(O.solo ? navne[0] : navne[nr === 'begge' ? 0 : nr]);
}

function vis(html){
  app.innerHTML = `<div class="skaerm">${html}</div>`;
  scrollTo({top:0, behavior:'smooth'});
}
const KREDIT = `<div class="kredit">
  <b>Solformørkelses-Missionen</b><br>
  Lavet af Michel Klos · 2026</div>`;

/* ================================================================
   START
   ================================================================ */
function start(){
  document.getElementById('top').classList.add('skjul');
  stjerner = 0; trin = 0;
  vis(`
    <div style="text-align:center;padding:26px 0 10px">
      <div style="font-size:74px;line-height:1" class="pulser">🌘</div>
      <h1 style="margin-top:14px">Solformørkelses-<br>Missionen</h1>
      <p style="margin-top:10px">Den <b style="color:#ffd166">${FAKTA.dato}</b> forsvinder
      op mod <b style="color:#ffd166">88 %</b> af solen over Danmark.<br>
      Det er den kraftigste siden 2015.</p>
      <p class="lille" style="margin-top:16px">Et spil af <b style="color:#a8b2d1">Michel Klos</b></p>
    </div>

    <div class="kort" style="margin-top:24px">
      <div class="badge">Hvor mange spiller?</div>
      <div class="spillervalg">
        <button onclick="opsaet(1)"><span class="prik p1"></span>Én spiller<small>alene</small></button>
        <button onclick="opsaet(2)"><span class="prik pb"></span>To spillere<small>skiftes til opgaverne</small></button>
      </div>
    </div>

    <p class="lille" style="text-align:center">🕐 Ca. 15 minutter &nbsp;·&nbsp; ⭐ Saml stjerner
    &nbsp;·&nbsp; 📱 Virker bedst på mobil</p>
    ${KREDIT}
  `);
}

function opsaet(antal){
  lydJa();
  vis(`
    <div class="badge" style="margin-top:20px">Næsten klar</div>
    <h2>Hvad hedder ${antal === 1 ? 'du' : 'I'}?</h2>
    <p class="lille" style="margin-bottom:14px">Navnet kommer på diplomet til sidst.
    ${antal === 1 ? 'Du kan også bare springe over.' : 'I kan også bare springe over.'}</p>
    <div class="kort">
      <div class="navnefelt">
        <span class="prik p1"></span>
        <input id="n0" maxlength="14" placeholder="Navn" autocomplete="off" autocorrect="off">
      </div>
      ${antal === 2 ? `<div class="navnefelt" style="margin-bottom:0">
        <span class="prik p2"></span>
        <input id="n1" maxlength="14" placeholder="Navn" autocomplete="off" autocorrect="off">
      </div>` : ''}
    </div>
    <button class="knap" onclick="gemNavne(${antal})">Videre →</button>
    <button class="knap sekundaer" onclick="start()">← Tilbage</button>
  `);
  setTimeout(() => {
    const f = document.getElementById('n0');
    if(f) f.addEventListener('keydown', e => { if(e.key === 'Enter') gemNavne(antal); });
  }, 60);
}

function gemNavne(antal){
  const v = i => { const el = document.getElementById('n'+i); return el ? el.value.trim() : ''; };
  navne = antal === 1
    ? [v(0) || 'Rumforsker']
    : [v(0) || 'Spiller 1', v(1) || 'Spiller 2'];
  briefing();
}

function briefing(){
  vis(`
    <div class="badge" style="margin-top:20px">Missionsbriefing</div>
    <h2>${O.dinStor()} opgave</h2>
    <div class="kort" style="margin-top:12px">
      <p>Godt ${O.solo ? 'du er' : 'I er'} her, <b style="color:#ffd166">${O.alle()}</b>.</p>
      <p style="margin-top:10px">Den <b style="color:#ffd166">${FAKTA.dato}</b> sker der noget,
      der ikke er sket i Danmark siden år 2015 — og som ikke sker igen, før ${O.erVoksne()}.</p>
      <p style="margin-top:10px">Månen skubber sig ind foran solen, og
      <b style="color:#ffd166">${FAKTA.daekning} %</b> af solen forsvinder.
      Himlen bliver mørk midt om aftenen.</p>
      <p style="margin-top:10px">${O.dinStor()} opgave: find ud af hvorfor det sker,
      lav formørkelsen selv — og lær at se på den uden at komme til skade.</p>
    </div>
    <button class="knap" onclick="kapitel1()">Start missionen 🚀</button>
    <button class="knap sekundaer" onclick="start()">← Tilbage til forsiden</button>
  `);
}

/* ================================================================
   KAPITEL 1 — TIDSMASKINEN
   ================================================================ */
function kapitel1(){
  trin = 1; opdaterTop();
  vis(`
    <div class="badge">Kapitel 1 af 3 · Tidsmaskinen</div>
    <h2>Hvad troede folk før i tiden?</h2>
    <p style="margin-bottom:14px">For 1000 år siden vidste ingen hvorfor solen pludselig
    blev væk. Så de fandt på forklaringer.</p>
    ${videoHTML('intro')}
    ${tur(0)}
    <button class="knap" onclick="myter(0)">Fyr løs 🕰️</button>
