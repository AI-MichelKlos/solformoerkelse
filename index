/* Areal af overlap mellem to cirkler → dækningsprocent */
function overlapProcent(d, rSol, rMaane){
  if(d >= rSol + rMaane) return 0;
  if(d <= Math.abs(rSol - rMaane)) return Math.min(rMaane, rSol)**2 / rSol**2 * 100;
  const a = rMaane*rMaane * Math.acos((d*d + rMaane*rMaane - rSol*rSol) / (2*d*rMaane));
  const b = rSol*rSol   * Math.acos((d*d + rSol*rSol   - rMaane*rMaane) / (2*d*rSol));
  const c = .5 * Math.sqrt((-d+rMaane+rSol)*(d+rMaane-rSol)*(d-rMaane+rSol)*(d+rMaane+rSol));
  return (a + b - c) / (Math.PI * rSol * rSol) * 100;
}

let maxNaaet = 0;

