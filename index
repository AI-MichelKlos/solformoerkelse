function saetTraek(){
  const svg   = document.getElementById('svg'),
        maane = document.getElementById('maane'),
        haand = document.getElementById('maanehaand'),
        scene = document.getElementById('scene'),
        himmel= document.getElementById('himmel'),
        glow  = document.getElementById('glow'),
        hjaelp= document.getElementById('hjaelp');
  const rSol = 52, rMaane = 48.5, solX = 150, solY = 120;
  let traekker = false, laast = false;

  function tilSVG(e){
    const r = svg.getBoundingClientRect();
    const p = e.touches ? e.touches[0] : e;
    return { x:(p.clientX - r.left)/r.width*300, y:(p.clientY - r.top)/r.height*300 };
  }
  function flyt(x, y){
    x = Math.max(20, Math.min(280, x));
    y = Math.max(-70, Math.min(215, y));
    // Lille "magnet" tæt på solen, så små fingre også kan ramme rent
    let d = Math.hypot(x - solX, y - solY);
    if(d > 0 && d < 30){
      const nyD = d * Math.pow(d/30, 1.3);
      x = solX + (x - solX)/d * nyD;
      y = solY + (y - solY)/d * nyD;
      d = nyD;
    }
    maane.setAttribute('cx', x); maane.setAttribute('cy', y);
    haand.setAttribute('cx', x); haand.setAttribute('cy', y);

    const pct = overlapProcent(d, rSol, rMaane);
    if(pct > maxNaaet) maxNaaet = pct;
    document.getElementById('mDaek').textContent = Math.round(pct) + ' %';
    const lys = Math.max(4, Math.round(100 - Math.pow(pct/100, 2.6) * 96));
    document.getElementById('mLys').textContent  = lys + ' %';
    document.getElementById('mTemp').textContent = Math.round(22 - pct/100*5) + '°';
    himmel.style.opacity = Math.pow(pct/100, 2.6) * .82;
    glow.setAttribute('r', 96 - pct*0.42);
    if(pct > 8) hjaelp.style.opacity = 0;
    if(pct >= 78 && !laast){ laast = true; ramt(Math.round(maxNaaet)); }
  }

  const ned  = e => { if(!laast){ traekker = true; e.preventDefault(); } };
  const over = e => { if(traekker && !laast){ const p = tilSVG(e); flyt(p.x, p.y); e.preventDefault(); } };
  const op   = () => traekker = false;
  haand.addEventListener('touchstart', ned, {passive:false});
  haand.addEventListener('mousedown', ned);
  scene.addEventListener('touchmove', over, {passive:false});
  scene.addEventListener('mousemove', over);
  addEventListener('touchend', op); addEventListener('mouseup', op);
}

